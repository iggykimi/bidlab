# Current BidLab settings for demo, manual and opt-in live. No secrets included.
BIDLAB_MODE=demo
BIDLAB_BIND_HOST=127.0.0.1
BIDLAB_PORT=8000
BIDLAB_STORAGE_DIR=./storage
BIDLAB_HISTORY_ENABLED=false
BIDLAB_META_BUDGET_USD=20.00
META_MODEL=muse-spark-1.3
# Contributor mode (trains on content; use only with synthetic data + explicit author consent):
# META_MODEL=muse-spark-1.3-contributor
MODEL_API_KEY=
# Full chat/completions endpoint for live extraction. Process environment
# only (the adapter does not read it from this file):
# META_API_URL=https://api.meta.ai/v1/chat/completions
# Speech-to-text file endpoint for «Pregúntale al pliego». Derived from
# META_API_URL when it ends in /chat/completions; set it for any other base:
# META_TRANSCRIBE_URL=https://api.meta.ai/v1/asr/transcribe
# META_API_KEY belongs to the Muse Code CLI environment, not the application.
