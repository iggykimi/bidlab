<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>BidLab — Informe de decisión</title>
<style>
  body { font-family: system-ui, sans-serif; color: #172033; max-width: 70ch; margin: 2rem auto; padding: 0 1rem; }
  .badge { display: inline-block; padding: .2rem .6rem; border-radius: .4rem; font-size: .85rem; }
  .demo { background: #fff4d6; border: 1px solid #9a5b00; }
  .decision { background: #e8efff; border: 1px solid #3159d9; }
  table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
  th, td { border: 1px solid #c9d2e8; padding: .4rem .6rem; text-align: left; }
  .num { font-variant-numeric: tabular-nums; text-align: right; }
  blockquote { border-left: 3px solid #3159d9; margin: .5rem 0; padding: .2rem .8rem; color: #333; }
  h2 { margin-top: 2rem; border-bottom: 1px solid #c9d2e8; }
  @media print { body { margin: 0; } }
</style>
</head>
<body>
{% set ES = {"unknown": "sin determinar", "unsupported": "no soportada", "not_applicable": "no aplicable"} %}
{% set MATCH_ES = {"exact": "literal", "normalized_match": "coincidencia normalizada", "missing": "no localizada", "manual_visual": "localizada a mano"} %}
{% if mode == "demo" %}<p><span class="badge demo">Demo curada: cifras de semilla revisada, no extracción en vivo</span></p>{% endif %}
<h1>Informe de decisión — {{ report.scenario.context.tender_title }}</h1>
<p><span class="badge decision">{{ report.decision }}</span></p>
<p>Escenario <strong>{{ report.scenario.name }}</strong> · {{ report.created_at }}</p>
{% if report.scenario.input is defined %}<p>Archivado el {{ report.created_at }} · Fórmula {{ report.scenario.input.pricing_rule_id }} rev. {{ report.scenario.input.pricing_rule_revision }} · Empresa rev. {{ report.scenario.input.company_revision }} · Copia {{ report.scenario.snapshot_sha256[:12] }}…</p>{% endif %}

<h2>Resultado</h2>
<table>
<tr><th>Concepto</th><th class="num">Valor</th></tr>
<tr><td>Precio neto</td><td class="num">{{ report.scenario.result.price_net }} €</td></tr>
<tr><td>Coste neto</td><td class="num">{{ report.scenario.result.cost_net or "—" }} €</td></tr>
<tr><td>Beneficio</td><td class="num">{{ report.scenario.result.profit_net or "—" }} €</td></tr>
<tr><td>Margen</td><td class="num">{{ report.scenario.result.margin_rate or "—" }}</td></tr>
<tr><td>Puntuación</td><td class="num">{{ report.scenario.result.score.value or ES.get(report.scenario.result.score.status, report.scenario.result.score.status) }}</td></tr>
<tr><td>Anormalidad</td><td class="num">{{ ES.get(report.scenario.result.anomaly.status, report.scenario.result.anomaly.status) }}</td></tr>
</table>

<h2>Nota de decisión</h2>
<p>{{ report.note }}</p>

<h2>Detalle del cálculo</h2>
<table>
<tr><th>Paso</th><th>Expresión</th><th class="num">Valor</th></tr>
{% for step in report.scenario.result.trace %}
<tr><td>{{ step.label }}</td><td><code>{{ step.expression }}</code></td><td class="num">{{ step.value or "sin determinar" }}</td></tr>
{% endfor %}
</table>

<h2>Hipótesis</h2>
<ul>
{% for item in report.scenario.result.assumptions %}
<li>{{ item }}</li>
{% endfor %}
</ul>

<h2>Pendientes</h2>
<ul>
{% for item in report.pending_items %}
<li>{{ item }}</li>
{% else %}
<li>Sin pendientes registrados.</li>
{% endfor %}
</ul>

<h2>Fuentes</h2>
{% for cit in report.scenario.context.citations %}
<blockquote>
<p>{{ cit.verbatim_excerpt }}</p>
<footer>Documento {{ cit.document_id }}, página {{ cit.page_number }} · {{ MATCH_ES.get(cit.match_status, cit.match_status) }}</footer>
</blockquote>
{% else %}
<p>Sin citas vinculadas.</p>
{% endfor %}

<h2>Integridad</h2>
<p>Instantánea (snapshot) <code>{{ report.scenario.snapshot_sha256 }}</code> · motor {{ report.scenario.result.engine_version }} · generado {{ generated_at }}</p>
</body>
</html>
