{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ClaimProposal"
      },
      "minItems": 0,
      "maxItems": 80
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RequirementProposal"
      },
      "minItems": 0,
      "maxItems": 80
    },
    "pricing_formula": {
      "$ref": "#/$defs/FormulaProposal"
    },
    "anomaly_text": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4000
        },
        {
          "type": "null"
        }
      ]
    },
    "anomaly_citations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CitationProposal"
      },
      "minItems": 0,
      "maxItems": 5
    },
    "unread_pages": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 0,
      "maxItems": 120
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      },
      "minItems": 0,
      "maxItems": 30
    }
  },
  "required": [
    "schema_version",
    "claims",
    "requirements",
    "pricing_formula",
    "anomaly_text",
    "anomaly_citations",
    "unread_pages",
    "warnings"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CitationProposal": {
      "type": "object",
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "page_number": {
          "type": "integer",
          "minimum": 1
        },
        "verbatim_excerpt": {
          "type": "string",
          "maxLength": 600
        }
      },
      "required": [
        "document_id",
        "page_number",
        "verbatim_excerpt"
      ],
      "additionalProperties": false
    },
    "ClaimProposal": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "maxLength": 80
        },
        "raw_value": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "normalized_value": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CitationProposal"
          },
          "minItems": 0,
          "maxItems": 3
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "not_found",
            "ambiguous",
            "unsupported"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "minItems": 0,
          "maxItems": 10
        }
      },
      "required": [
        "key",
        "raw_value",
        "normalized_value",
        "unit",
        "citations",
        "confidence",
        "status",
        "notes"
      ],
      "additionalProperties": false
    },
    "RequirementProposal": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "maxLength": 80
        },
        "label": {
          "type": "string",
          "maxLength": 1000
        },
        "category": {
          "type": "string",
          "enum": [
            "financial",
            "technical",
            "team",
            "legal",
            "submission",
            "other"
          ]
        },
        "logic_hint": {
          "type": "string",
          "enum": [
            "AND",
            "OR",
            "LEAF",
            "unknown"
          ]
        },
        "group_key": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "condition_text": {
          "type": "string",
          "maxLength": 2000
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CitationProposal"
          },
          "minItems": 0,
          "maxItems": 3
        },
        "ambiguities": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "minItems": 0,
          "maxItems": 10
        }
      },
      "required": [
        "key",
        "label",
        "category",
        "logic_hint",
        "group_key",
        "condition_text",
        "citations",
        "ambiguities"
      ],
      "additionalProperties": false
    },
    "FormulaProposal": {
      "type": "object",
      "properties": {
        "formula_literal": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "template_hint": {
          "type": "string",
          "enum": [
            "proportional_inverse",
            "linear_discount",
            "log_ratio",
            "unsupported"
          ]
        },
        "max_points": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?\\d{1,12}(\\.\\d{1,12})?$",
              "description": "Base-10 decimal string; no locale separators, NaN or Infinity."
            },
            {
              "type": "null"
            }
          ]
        },
        "variables": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "minItems": 0,
          "maxItems": 20
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CitationProposal"
          },
          "minItems": 0,
          "maxItems": 3
        },
        "ambiguities": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "minItems": 0,
          "maxItems": 20
        }
      },
      "required": [
        "formula_literal",
        "template_hint",
        "max_points",
        "variables",
        "citations",
        "ambiguities"
      ],
      "additionalProperties": false
    }
  }
}