{
  "name": "bidlab-video",
  "private": true,
  "version": "1.0.0",
  "description": "BidLab 180 s demo video as code: real app captures (Playwright) composed with Remotion.",
  "scripts": {
    "capture": "playwright test -c capture/capture.config.ts",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts BidLab out/bidlab-180s.mp4 --codec h264 --crf 18"
  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "@remotion/fonts": "^4.0.535",
    "@remotion/transitions": "^4.0.535",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
